# Database configuration - PostgreSQL is primary
# Local development: postgresql://postgres:postgres@localhost:5432/resume_builder
# Production: Set DATABASE_URL to your PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resume_builder

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-here

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# AI Provider Selection (gemini, openai, anthropic)
# This is REQUIRED - the application will not start without it.
# For OpenRouter: set to "openai" and configure OPENAI_API_KEY with your OpenRouter key.
AI_PROVIDER=openai

# --- OpenRouter Configuration (OpenAI Compatible) ---
# Get your API key from https://openrouter.ai/keys
OPENAI_API_KEY=sk-or-v1-your-openrouter-api-key
OPENAI_MODEL=openai/gpt-4.1-mini
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# --- Direct OpenAI Configuration ---
# OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Gemini Configuration ---
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-2.0-flash

# --- Anthropic (Claude) Configuration ---
# ANTHROPIC_API_KEY=your-anthropic-api-key
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# AI Provider Settings (shared across all providers)
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=8192
AI_TIMEOUT=60.0
AI_MAX_RETRIES=3
AI_RETRY_BASE_DELAY=1.0
AI_RETRY_MAX_DELAY=30.0

# --- Fallback Chain ---
# Comma-separated ordered list of providers to try (primary first).
# Example: gemini,openai,anthropic
AI_FALLBACK_CHAIN=gemini,openai,anthropic

# --- Token Budgeting (per-request limits, always enforced) ---
AI_MAX_INPUT_TOKENS=8000
AI_MAX_OUTPUT_TOKENS=8192

# --- Per-User Token Limits (0 = unlimited, enforced when user_id provided) ---
AI_USER_DAILY_TOKEN_LIMIT=100000
AI_USER_MONTHLY_TOKEN_LIMIT=1000000

# --- Response Cache ---
AI_CACHE_ENABLED=true
AI_CACHE_TTL=3600
AI_CACHE_MAX_SIZE=1000

# Server Port (default 8000)
PORT=8000

# Environment (development, staging, production)
ENVIRONMENT=development
